 "jinja": {
  "paperkiln/1": "{%- if messages and messages[0]['role'] == 'system' -%}{%- set sys = messages[0]['content'] -%}{%- set msgs = messages[1:] -%}{%- else -%}{%- set sys = none -%}{%- set msgs = messages -%}{%- endif -%}{%- for m in msgs -%}{%- if (m['role'] == 'user') != (loop.index0 % 2 == 0) -%}{{ raise_exception('user and assistant messages alternate from the user') }}{%- endif -%}{%- if m['role'] == 'user' -%}{{- '<|user|>' -}}{%- if loop.first and sys is not none -%}{{- sys + '\\n\\n' -}}{%- endif -%}{{- m['content'] + '' -}}{%- else -%}{{- '<|assistant|>' + m['content'] + '<|endoftext|>' -}}{%- endif -%}{%- endfor -%}{%- if add_generation_prompt -%}{{- '<|assistant|>' -}}{%- endif -%}",
  "paperkiln/1 none": "{%- if messages and messages[0]['role'] == 'system' -%}{%- set sys = messages[0]['content'] -%}{%- set msgs = messages[1:] -%}{%- else -%}{%- set sys = none -%}{%- set msgs = messages -%}{%- endif -%}{%- if sys is not none -%}{{ raise_exception('this model\\'s template has no system role') }}{%- endif -%}{%- for m in msgs -%}{%- if (m['role'] == 'user') != (loop.index0 % 2 == 0) -%}{{ raise_exception('user and assistant messages alternate from the user') }}{%- endif -%}{%- if m['role'] == 'user' -%}{{- '<|user|>' -}}{{- m['content'] + '' -}}{%- else -%}{{- '<|assistant|>' + m['content'] + '<|endoftext|>' -}}{%- endif -%}{%- endfor -%}{%- if add_generation_prompt -%}{{- '<|assistant|>' -}}{%- endif -%}",
  "paperkiln/legacy-word": "{%- if messages and messages[0]['role'] == 'system' -%}{%- set sys = messages[0]['content'] -%}{%- set msgs = messages[1:] -%}{%- else -%}{%- set sys = none -%}{%- set msgs = messages -%}{%- endif -%}{%- for m in msgs -%}{%- if (m['role'] == 'user') != (loop.index0 % 2 == 0) -%}{{ raise_exception('user and assistant messages alternate from the user') }}{%- endif -%}{%- if m['role'] == 'user' -%}{{- 'user: ' -}}{%- if loop.first and sys is not none -%}{{- sys + '\\n\\n' -}}{%- endif -%}{{- m['content'] + ' ' -}}{%- else -%}{{- 'assistant: ' + m['content'] + ' ' -}}{%- endif -%}{%- endfor -%}{%- if add_generation_prompt -%}{{- 'assistant:' -}}{%- endif -%}"
 },
 "modelfile": {
  "paperkiln/1": "# Ollama Modelfile for model.gguf: chat template paperkiln/1 (LOCAL_LLM_STACK.md section 3, point 3).\nFROM ./model.gguf\nTEMPLATE \"\"\"{{- range $i, $m := .Messages }}{{- if eq $m.Role \"user\" }}<|user|>{{- if and $.System (eq $i 0) }}{{ $.System }}\n\n{{ end }}{{ $m.Content }}{{- else if eq $m.Role \"assistant\" }}<|assistant|>{{ $m.Content }}<|endoftext|>{{- end }}{{- end }}<|assistant|>\"\"\"\nPARAMETER stop \"<|endoftext|>\"\nPARAMETER stop \"<|user|>\"\nPARAMETER stop \"<|assistant|>\"\n"
 },
