{
  "_comment": "paperkiln IR v0 for arxiv_expr_norm_gate, exported by mtstudio. Schema and semantics: microtorch/ir.hpp and LOCAL_LLM_STACK.md section 4.",
  "ir_version": 0,
  "family_hint": "flex",
  "model": {
    "vocab": 8192,
    "d": 128,
    "n_layers": 2,
    "ctx": 64,
    "dtype": "f32"
  },
  "tokenizer": {
    "type": "bpe",
    "source": "gguf",
    "specials": {
      "unk": 0,
      "eot": 1,
      "user": 2,
      "assistant": 3
    },
    "bos": null
  },
  "inputs": [
    {
      "name": "tokens",
      "kind": "token_ids"
    },
    {
      "name": "pos",
      "kind": "positions",
      "note": "absolute positions; prefill 0..T-1, decode = tokens seen so far; must stay below model.ctx"
    }
  ],
  "embed": {
    "nodes": [
      {
        "op": "embedding",
        "in": [
          "tokens"
        ],
        "weight": "token_embd.weight",
        "out": "x"
      }
    ]
  },
  "block": {
    "repeat": 2,
    "state": [
      {
        "name": "kv",
        "kind": "kv",
        "heads": 4,
        "kv_heads": 4,
        "head_dim": 32,
        "max_len": 64,
        "window": 0,
        "sinks": 0,
        "dtype": "f32"
      }
    ],
    "nodes": [
      {
        "op": "expr",
        "in": [
          "x"
        ],
        "expr": "(x - rowmean(x)) / sqrt(abs(rowmean(x * (x - rowmean(x)))))",
        "out": "h"
      },
      {
        "op": "linear",
        "in": [
          "h"
        ],
        "weight": "blk.{i}.attn_norm_gain.weight",
        "bias": "blk.{i}.attn_norm_gain.bias",
        "_note": "the expr norm's per-feature gain g and bias b: weight diag(g) [d, d]",
        "out": "h"
      },
      {
        "op": "linear",
        "in": [
          "h"
        ],
        "weight": "blk.{i}.attn_qkv.weight",
        "bias": "blk.{i}.attn_qkv.bias",
        "out": "qkv"
      },
      {
        "op": "split",
        "in": [
          "qkv"
        ],
        "sizes": [
          128,
          128,
          128
        ],
        "out": [
          "q",
          "k",
          "v"
        ]
      },
      {
        "op": "rope",
        "in": [
          "q",
          "k",
          "pos"
        ],
        "heads": 4,
        "head_dim": 32,
        "theta": 10000.0,
        "rope_heads": "all",
        "pairing": "interleaved",
        "_note": "adjacent pairs (x[2j], x[2j+1]) within each head, angle pos * theta^(-2j/head_dim); products rounded separately (no FMA)",
        "out": [
          "q",
          "k"
        ]
      },
      {
        "op": "attention",
        "in": [
          "q",
          "k",
          "v"
        ],
        "state": "kv",
        "heads": 4,
        "kv_heads": 4,
        "head_dim": 32,
        "causal": true,
        "scale": 0.17677669,
        "window": 0,
        "sinks": 0,
        "softmax": "max-shifted, masked entries exactly zero",
        "out": "a"
      },
      {
        "op": "linear",
        "in": [
          "a"
        ],
        "weight": "blk.{i}.attn_output.weight",
        "bias": "blk.{i}.attn_output.bias",
        "out": "o"
      },
      {
        "op": "add",
        "in": [
          "x",
          "o"
        ],
        "out": "x"
      },
      {
        "op": "expr",
        "in": [
          "x"
        ],
        "expr": "(x - rowmean(x)) / sqrt(abs(rowmean(x * (x - rowmean(x)))))",
        "out": "h2"
      },
      {
        "op": "linear",
        "in": [
          "h2"
        ],
        "weight": "blk.{i}.ffn_norm_gain.weight",
        "bias": "blk.{i}.ffn_norm_gain.bias",
        "_note": "the expr norm's per-feature gain g and bias b: weight diag(g) [d, d]",
        "out": "h2"
      },
      {
        "op": "linear",
        "in": [
          "h2"
        ],
        "weight": "blk.{i}.ffn_up.weight",
        "bias": "blk.{i}.ffn_up.bias",
        "out": "u"
      },
      {
        "op": "expr",
        "in": [
          "u"
        ],
        "expr": "relu(x)^2",
        "out": "u"
      },
      {
        "op": "linear",
        "in": [
          "u"
        ],
        "weight": "blk.{i}.ffn_down.weight",
        "bias": "blk.{i}.ffn_down.bias",
        "out": "f"
      },
      {
        "op": "add",
        "in": [
          "x",
          "f"
        ],
        "out": "x"
      }
    ]
  },
  "head": {
    "nodes": [
      {
        "op": "expr",
        "in": [
          "x"
        ],
        "expr": "(x - rowmean(x)) / sqrt(abs(rowmean(x * (x - rowmean(x)))))",
        "out": "h"
      },
      {
        "op": "linear",
        "in": [
          "h"
        ],
        "weight": "output_norm_gain.weight",
        "bias": "output_norm_gain.bias",
        "_note": "the expr norm's per-feature gain g and bias b: weight diag(g) [d, d]",
        "out": "h"
      },
      {
        "op": "linear",
        "in": [
          "h"
        ],
        "weight": "output.weight",
        "bias": null,
        "out": "logits"
      }
    ]
  },
  "outputs": [
    {
      "name": "logits",
      "kind": "logits"
    }
  ],
  "modes": {
    "prefill": "all nodes over T tokens",
    "decode": "the same graph with T = 1; attention reads and appends to its kv state"
  }
}
