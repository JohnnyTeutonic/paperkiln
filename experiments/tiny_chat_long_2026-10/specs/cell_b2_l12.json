{
 "name": "tc_b2_l12",
 "arch": {
  "preset": "llama-tiny",
  "rope_heads": "all",
  "custom": {
   "d": 768,
   "layers": 12,
   "heads": 12,
   "d_ff": 2048
  },
  "state_tokens": {
   "k": 4,
   "mask": "causal"
  }
 },
 "data": {
  "corpus": "/content/chat/data/mix_s35.ids",
  "vocab": "/content/chat/upload/vocab_llama3_bpe.gguf",
  "vocab_cap": 16384,
  "T": 1024,
  "max_tokens": 0
 },
 "train": {
  "steps": 60000,
  "lr": 0.0005,
  "batch": 8,
  "accum": 2,
  "clip": 1.0,
  "eval_every": 1000,
  "eval_windows": 32,
  "checkpoint_every": 100,
  "gradmap_every": 0,
  "seed": 1,
  "optimizer": "adamw",
  "lr_schedule": {
   "warmup_steps": 2000,
   "decay": "cosine",
   "min_lr_frac": 0.1
  }
 },
 "export": {
  "formats": [
   "safetensors",
   "gguf"
  ]
 },
 "_shape": {
  "note": "the rung job's shape: arch and T only reach it"
 }
}
