   "new_ops": [
    {
     "name": "xl_relative_attention",
     "kind": "needs_new_primitive",
     "replaces": "self-attention score and positional encoding",
     "reason": "Attention over [memory; segment] keys with score A_ij = q_i^T k_j + q_i^T W_{k,R} R_{i-j} + u^T k_j + v^T W_{k,R} R_{i-j}, where R is a fixed sinusoid encoding indexed by relative distance i-j, W_{k,R} a learned projection, u and v learned d-dim global biases; followed by masked softmax. Needs a relative-position attention primitive taking query [L,d], keys/values [M+L,d], and relative sinusoid table [M+L,d].",
     "quote": "Following the idea of only relying on relative positional information, we propose to re-parameterize the four terms as follows",
     "where": "Sec. Relative Positional Encodings",
     "inputs": [],
     "errors": [],
     "quote_found": true,
     "check": "verified"
    },
    {
     "name": "segment_memory_concat",
     "kind": "needs_new_primitive",
     "replaces": "key/value context of attention",
     "reason": "Cross-segment recurrence: per layer, a cache of the previous layer's hidden states of length M from earlier segments (stop-gradient) is concatenated along the time axis with current hidden states to form keys/values; requires stateful memory across forward passes.",
     "quote": "Thus, we can cache a predefined length-$M$ old hidden states spanning (possibly) multiple segments, and refer to them as the memory $\\rvm_{\\tau}^{n} \\in \\R^{M \\times d}$",
     "where": "Sec. Segment-Level Recurrence with State Reuse",
     "inputs": [],
     "errors": [],
     "quote_found": true,
     "check": "verified"
    }
