 "audit_script": "import importlib.util,json,subprocess,sys,hashlib\nfrom pathlib import Path\nroot=Path.cwd();sys.path.insert(0,str(root/'microtorch/papers'))\nimport fetch,flavor_bench as bench\nsource=subprocess.check_output(['git','-C','microtorch','show','ea40e502^:papers/fetch.py']).decode('utf-8')\nold=type(sys)('old_fetch');sys.modules[old.__name__]=old;exec(compile(source,'old_fetch.py','exec'),old.__dict__)\ndef result(m,aid,tex,truth):\n a=m.extract(aid,tex);out={}\n for field,want in truth.items():\n  f=a.fields.get(field);v=None if f is None or f.verdict=='contested' else f.value\n  if f is not None and f.verdict=='family' and m.FLAVOR_FAMILIES.get(field,{}).get(want)==v:v=want\n  out[field]={'value':v,'verdict':None if f is None else f.verdict,'truth':want,'score':'correct' if v==want else ('abstain' if v is None else 'wrong')}\n return out\nrows=[];totals={k:{s:0 for s in ('correct','abstain','wrong')} for k in ('before','after')}\nfor aid,truth in bench.TRUTH.items():\n p=bench.CACHE/f'{aid}.tex'\n if not p.exists():continue\n t=p.read_text(encoding='utf-8');b=result(old,aid,t,truth);a=result(fetch,aid,t,truth)\n for ver,r in [('before',b),('after',a)]:\n  for v in r.values():totals[ver][v['score']]+=1\n for f in truth:\n  if b[f]!=a[f]:rows.append({'arxiv_id':aid,'field':f,'before':b[f],'after':a[f]})\nx={'kind':'offline cached benchmark regression, existing labels unchanged','source_commit':'ea40e502','before_source_sha256':hashlib.sha256(source.encode()).hexdigest(),'after_source_sha256':hashlib.sha256(Path(fetch.__file__).read_bytes()).hexdigest(),'totals':totals,'changed':rows}\np=root/'microtorch/papers/llm_extract_receipts/2026-10-30_rule_lexical_regression.json';assert not p.exists();p.write_text(json.dumps(x,indent=1)+'\\n',encoding='utf-8');print(json.dumps(x))\n",
