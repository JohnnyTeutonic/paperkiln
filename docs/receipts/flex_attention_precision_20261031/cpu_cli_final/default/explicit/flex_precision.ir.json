{
  "_comment": "paperkiln IR v1 for flex_precision, exported by mtstudio. Schema and semantics: microtorch/spec/IR_SPEC.md (schema spec/ir.schema.json).",
  "ir_version": 1,
  "family_hint": "gpt2",
  "model": {
    "vocab": 7,
    "d": 8,
    "n_layers": 1,
    "ctx": 8,
    "dtype": "f32"
  },
  "tokenizer": {
    "type": "word",
    "source": "gguf",
    "specials": {
      "unk": 0
    },
    "bos": null
  },
  "inputs": [
    {
      "name": "tokens",
      "kind": "token_ids"
    },
    {
      "name": "pos",
      "kind": "positions",
      "note": "absolute positions; prefill 0..T-1, decode = cache length; must stay below model.ctx"
    }
  ],
  "embed": {
    "nodes": [
      {
        "op": "embedding",
        "in": [
          "tokens"
        ],
        "weight": "token_embd.weight",
        "out": "x"
      },
      {
        "op": "pos_embedding",
        "in": [
          "x",
          "pos"
        ],
        "weight": "position_embd.weight",
        "out": "x"
      }
    ]
  },
  "block": {
    "repeat": 1,
    "state": [
      {
        "name": "kv",
        "kind": "kv",
        "heads": 2,
        "kv_heads": 2,
        "head_dim": 4,
        "max_len": 8,
        "window": 0,
        "sinks": 0,
        "dtype": "f32"
      }
    ],
    "nodes": [
      {
        "op": "layernorm",
        "in": [
          "x"
        ],
        "weight": "blk.{i}.attn_norm.weight",
        "bias": "blk.{i}.attn_norm.bias",
        "eps": 1e-05,
        "out": "h"
      },
      {
        "op": "linear",
        "in": [
          "h"
        ],
        "weight": "blk.{i}.attn_qkv.weight",
        "bias": "blk.{i}.attn_qkv.bias",
        "out": "qkv"
      },
      {
        "op": "split",
        "in": [
          "qkv"
        ],
        "sizes": [
          8,
          8,
          8
        ],
        "out": [
          "q",
          "k",
          "v"
        ]
      },
      {
        "op": "attention",
        "in": [
          "q",
          "k",
          "v"
        ],
        "state": "kv",
        "heads": 2,
        "kv_heads": 2,
        "head_dim": 4,
        "causal": true,
        "scale": 0.5,
        "window": 0,
        "sinks": 0,
        "softmax": "max-shifted, masked entries exactly zero",
        "out": "a"
      },
      {
        "op": "linear",
        "in": [
          "a"
        ],
        "weight": "blk.{i}.attn_output.weight",
        "bias": "blk.{i}.attn_output.bias",
        "out": "o"
      },
      {
        "op": "add",
        "in": [
          "x",
          "o"
        ],
        "out": "x"
      },
      {
        "op": "layernorm",
        "in": [
          "x"
        ],
        "weight": "blk.{i}.ffn_norm.weight",
        "bias": "blk.{i}.ffn_norm.bias",
        "eps": 1e-05,
        "out": "h2"
      },
      {
        "op": "linear",
        "in": [
          "h2"
        ],
        "weight": "blk.{i}.ffn_up.weight",
        "bias": "blk.{i}.ffn_up.bias",
        "out": "u"
      },
      {
        "op": "gelu",
        "in": [
          "u"
        ],
        "approx": "tanh",
        "out": "u"
      },
      {
        "op": "linear",
        "in": [
          "u"
        ],
        "weight": "blk.{i}.ffn_down.weight",
        "bias": "blk.{i}.ffn_down.bias",
        "out": "f"
      },
      {
        "op": "add",
        "in": [
          "x",
          "f"
        ],
        "out": "x"
      }
    ]
  },
  "head": {
    "nodes": [
      {
        "op": "layernorm",
        "in": [
          "x"
        ],
        "weight": "output_norm.weight",
        "bias": "output_norm.bias",
        "eps": 1e-05,
        "out": "h"
      },
      {
        "op": "linear",
        "in": [
          "h"
        ],
        "weight": "output.weight",
        "bias": null,
        "out": "logits"
      }
    ]
  },
  "outputs": [
    {
      "name": "logits",
      "kind": "logits"
    }
  ],
  "modes": {
    "prefill": "all nodes over T tokens",
    "decode": "the same graph with T = 1, attention reads and appends to the kv state"
  }
}
