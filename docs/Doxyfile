# Doxygen configuration for paperkiln.
# Run from repo root:  doxygen docs/Doxyfile
# Output lands in docs/html/ (gitignored; published by the docs workflow).

PROJECT_NAME           = "paperkiln"
PROJECT_BRIEF          = "Readable C++ LLM training stack: autograd, model families, studio, GGUF export (C++ namespace: microtorch)"
PROJECT_NUMBER         = 0.3.1
OUTPUT_DIRECTORY       = docs
INPUT                  = include src README.md
USE_MDFILE_AS_MAINPAGE = README.md
FILE_PATTERNS          = *.hpp *.cpp *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build*/* */models/*
# Markdown pages: mermaid diagrams drawn, repository links pointed at GitHub.
FILTER_PATTERNS        = "*.md=python3 docs/doxygen/md_filter.py https://github.com/JohnnyTeutonic/paperkiln master"

# The codebase documents itself with // prose comments rather than
# /** */ blocks; JAVADOC_BANNER + EXTRACT_ALL pulls those in so existing
# comments become documentation without a rewrite.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
HTML_EXTRA_STYLESHEET  = docs/doxygen/doxygen-awesome.css docs/doxygen/doxygen-awesome-sidebar-only.css
HAVE_DOT               = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

WARN_IF_UNDOCUMENTED   = NO
QUIET                  = YES
