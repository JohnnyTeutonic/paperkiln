# Reviewed cppcheck suppressions for the required static-analysis gate (2 November 2026).
# Every entry is a checked false positive or an intentional construct; add new entries only
# with a one-line reason. Paths are as passed on the command line (include/ src/ tests/ tools/).

missingIncludeSystem

# CHECK(cond && "message") idiom in the tests: the literal is deliberately always true.
incorrectStringBooleanError:tests/*

# log-sum-exp: the sum includes exp(0) = 1 for the row maximum, so z >= 1 and std::log(z) is defined.
invalidFunctionArg:src/ops.cpp
invalidFunctionArg:tests/policy_reference_baseline.cpp
invalidFunctionArg:tools/mtstudio.cpp
invalidFunctionArg:tools/bench_b2.cpp

# segs.back() in the batched forward: the first iteration always appends (prev starts at SIZE_MAX).
containerOutOfBounds:src/llama.cpp

# Intentional byte views of float buffers in the GGUF/safetensors writers and readers.
invalidPointerCast:src/gguf.cpp
invalidPointerCast:src/safetensors.cpp
invalidPointerCast:tools/mtstudio.cpp
invalidPointerCast:tools/make_timing_gguf.cpp

# check_control_tokens: tokens[i] is bounded by the loop; the later i < types.size() guards types[i].
arrayIndexThenCheck:include/microtorch/chat_template.hpp

# GNU void* arithmetic on the device optimiser state (GCC treats it as byte offsets). The
# behaviour-identical portable fix is a static_cast<char*>; it is left to the owner of src/nn.cpp.
arithOperationsOnVoidPointer:src/nn.cpp
