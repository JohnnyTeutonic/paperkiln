    "serve": {
      "on_finish": false
    }
  },
  "design": "grid",
  "factors": {
    "candidate": [
      {
        "arch.custom.norm": "layernorm",
        "arch.custom.activation": "gelu",
        "arch.custom.residual": "residual"
      },
      {
        "arch.custom.norm": "rmsnorm",
        "arch.custom.activation": "relu",
        "arch.custom.residual": "residual"
      },
      {
        "arch.custom.norm": "rmsnorm",
        "arch.custom.activation": "gelu",
        "arch.custom.residual": "residual"
      },
      {
        "arch.custom.norm": "layernorm",
        "arch.custom.activation": "relu",
        "arch.custom.residual": "residual"
      }
    ]
  },
  "seeds": [
    101,
    102
  ],
  "out_root": "prospective_atlas_runs"
}
