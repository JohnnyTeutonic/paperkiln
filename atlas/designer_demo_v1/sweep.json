{
  "base": {
    "arch": {
      "preset": "gpt2-nano",
      "custom": {
        "d": 64,
        "heads": 4,
        "layers": 2,
        "attention": "exact",
        "position": "learned",
        "norm": "layernorm",
        "activation": "gelu",
        "residual": "residual"
      }
    },
    "data": {
      "T": 64,
      "path": "REPLACE_WITH_PROSPECTIVE_CORPUS"
    },
    "train": {
