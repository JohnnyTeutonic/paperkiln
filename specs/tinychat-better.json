{
  "name": "tinychat-better",
  "arch": {
    "preset": "llama-tiny",
    "custom": {
      "d": 192,
      "layers": 3,
      "heads": 6
    }
  },
  "data": {
    "corpus": "data/tinychat.txt",
    "vocab": "releases/tinychat_vocab.gguf",
    "vocab_cap": 4096,
    "T": 128,
    "max_tokens": 2000000
  },
  "train": {
    "steps": 4000,
    "lr": 0.003,
    "eval_every": 200,
    "checkpoint_every": 200,
    "accum": 2,
    "gradmap_every": 100,
    "early_stopping": {
      "patience": 8,
      "min_delta": 0.002
    }
  },
  "export": {
    "formats": [
      "safetensors",
      "gguf"
    ]
  },
  "out_dir": "runs/tinychat-better"
}
