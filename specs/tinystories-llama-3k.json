{
  "name": "tinystories-llama-3k",
  "arch": {
    "preset": "llama-tiny"
  },
  "data": {
    "corpus": "data/tinystories_valid.txt",
    "vocab": "releases/tinystories_vocab.gguf",
    "vocab_cap": 4096,
    "T": 256
  },
  "train": {
    "steps": 3000,
    "lr": 0.003,
    "eval_every": 100,
    "checkpoint_every": 100,
    "accum": 2,
    "gradmap_every": 10,
    "early_stopping": {
      "patience": 8,
      "min_delta": 0.003
    }
  },
  "export": {
    "formats": [
      "safetensors",
      "gguf"
    ]
  },
  "serve": {
    "on_finish": true
  },
  "out_dir": "runs/tinystories-llama-3k"
}
