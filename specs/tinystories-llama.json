{
  "name": "tinystories-llama",
  "arch": {
    "preset": "llama-tiny"
  },
  "data": {
    "corpus": "data/tinystories_valid.txt",
    "vocab": "releases/tinystories_vocab.gguf",
    "vocab_cap": 4096,
    "T": 128
  },
  "train": {
    "steps": 300,
    "lr": 0.003,
    "eval_every": 50,
    "checkpoint_every": 100,
    "accum": 2,
    "early_stopping": {
      "patience": 4,
      "min_delta": 0.005
    }
  },
  "export": {
    "formats": [
      "safetensors",
      "gguf"
    ]
  },
  "serve": {
    "on_finish": true
  },
  "out_dir": "runs/tinystories-llama"
}
