{
  "name": "tinystories-nano",
  "arch": {
    "preset": "gpt2-nano"
  },
  "data": {
    "corpus": "data/tinystories_valid.txt",
    "vocab": "releases/tinystories_vocab.gguf",
    "vocab_cap": 4096,
    "T": 128
  },
  "train": {
    "steps": 200,
    "lr": 0.003,
    "eval_every": 25,
    "checkpoint_every": 50,
    "early_stopping": {
      "patience": 4,
      "min_delta": 0.01
    }
  },
  "export": {
    "formats": [
      "safetensors"
    ]
  },
  "serve": {
    "on_finish": false
  },
  "out_dir": "runs/tinystories-nano"
}
