{
 "_comment": "Next base (pk_base_v1): llama d768 L12 d_ff 2048, llama3-scheme 16384 vocabulary, T 512, 120000 steps x 16 x 512 = 0.98B tokens on a 4.20 GB mix (27% dialogue in the main part, 47% in the last 15%, read from step 102000). Generated by tools/colab_chat/make_next_base.py; source use: everyday 62%, fineweb 85%, oasst 62%, soda 62%, ultrachat 62%. Upload vocab_llama3_bpe.gguf with the runner's --upload. Extra jobs from arxiv_nb_v1.json: base_2302_13971, sft_2302_13971, base_2304_03208, sft_2304_03208.",
 "max_parallel": 5,
 "jobs": [
  {
   "name": "lever2",
   "cmd": [
    "python3",
    "corpus/fetchers/dialogue_pt.py",
    "all",
    "--out-dir",
    "{out}"
   ],
   "outputs": [
    "dialogue_pt_v1.ledger.json",
    "dialogue_soda_v1/report.json",
    "dialogue_oasst_v1/report.json",
    "dialogue_ultrachat_v1/report.json",
    "dialogue_everyday_v1/report.json"
   ]
  },
  {
   "name": "data",
   "after": [
    "lever2"
   ],
   "cmd": [
    "bash",
    "tools/colab_chat/next_base_data.sh",
    "{out}",
    "/content/chat/upload/vocab_llama3_bpe.gguf",
    "/content/chat/lever2",
    "/content/pk/corpus/data/fineweb_edu_shard0_v1/pretrain_train.txt"
   ],
   "env": {
    "MIX_MAIN": "everyday=0.000246,fineweb=0.730000,oasst=0.001414,soda=0.110880,ultrachat=0.157459",
    "MIX_TAIL": "everyday=0.000429,fineweb=0.530000,oasst=0.002462,soda=0.193014,ultrachat=0.274095",
    "MIX_BYTES": 4200000000,
    "TAIL_FRACTION": 0.15,
    "MIX_SEED": 1
   },
   "outputs": [
    "mix.ledger.json",
    "ids.json"
   ]
  },
  {
   "name": "gate",
   "model_name": "gate_llama3",
   "after": "data",
   "spec": {
    "arch": {
     "preset": "llama-tiny",
     "custom": {
      "d": 256,
      "layers": 4,
      "heads": 4,
      "d_ff": 768
     }
    },
    "data": {
     "corpus": "/content/chat/data/mix.main.ids",
     "vocab": "/content/chat/upload/vocab_llama3_bpe.gguf",
     "vocab_cap": 16384,
     "max_tokens": 20000000,
     "T": 256
    },
    "train": {
     "steps": 400,
     "lr": 0.001,
     "batch": 16,
     "eval_every": 200,
     "checkpoint_every": 200,
     "gradmap_every": 0,
     "seed": 1,
     "optimizer": "adamw"
    },
    "export": {
     "formats": [
      "safetensors",
      "gguf",
      "gguf_q8_0_all"
     ]
    }
   }
  },
  {
   "name": "base",
   "model_name": "pk_base_v1",
   "after": "data",
   "relay_every_steps": 5000,
   "spec": {
    "arch": {
     "preset": "llama-tiny",
     "custom": {
      "d": 768,
      "layers": 12,
      "heads": 12,
      "d_ff": 2048
     }
    },
    "data": {
     "corpus": "/content/chat/data/mix.main.ids",
     "vocab": "/content/chat/upload/vocab_llama3_bpe.gguf",
     "vocab_cap": 16384,
     "max_tokens": 0,
     "T": 512,
     "anneal": {
      "corpus": "/content/chat/data/mix.tail.ids",
      "from_fraction": 0.85
     }
    },
    "train": {
     "steps": 120000,
     "lr": 0.0006,
     "batch": 16,
     "eval_every": 1000,
     "checkpoint_every": 1000,
     "gradmap_every": 0,
     "seed": 1,
     "optimizer": "adamw",
     "lr_schedule": {
      "warmup_steps": 2000,
      "decay": "cosine",
      "min_lr_frac": 0.1
     }
    },
    "export": {
     "formats": [
      "safetensors",
      "gguf",
      "gguf_q8_0_all"
     ]
    }
   }
  },
  {
   "name": "lever1",
   "delay_s": 1800,
   "cmd": [
    "python3",
    "tools/lever1_sft.py",
    "--out-dir",
    "{out}",
    "--vocab",
    "/content/chat/upload/vocab_llama3_bpe.gguf",
    "--T",
    "512",
    "--jobs",
    "4"
   ],
   "outputs": [
    "lever1_sft_v1.jsonl",
    "lever1_sft_v1.ledger.json",
    "decontam_smol.json",
    "decontam_tinychat.json",
    "decontam_everyday.json"
   ]
  },
  {
   "name": "base_2302_13971",
