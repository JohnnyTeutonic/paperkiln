        "timeout",
        "--signal=TERM",
        "--kill-after=30",
        "2430",
        "python3",
        "/content/chat/upload/ternary_scale_boundary_gate.py",
        "--upload",
        "/content/chat/upload",
        "--manifest-sha256",
        "23defd7a3e47a792b148fd84e78191e8487c72f8fe28683c50e6c4694e062062",
        "--out",
