{
 "_comment": "W169's rehearsal (base2/w169/REGISTRATION.md section 7): its spec for 1,000 steps on N's corpus, a forced stop after the save of step 250, a held rung at 750, the end rung with its export.",
 "_base2": {
  "rehearsal": "W169",
  "steps": 1000,
  "checkpoint_every": 250,
  "pod_loss_drill_step": 250,
  "mark": 750,
  "rung_holds_training": true,
  "last_main_step": 850,
  "first_tail_step": 851,
  "params": 168588288,
  "store_release_grace_s": 600
 },
 "store_push_cap_gb": 40,
 "store_release_every_min": 20,
 "store_release_grace_s": 600,
 "store_stall_halt": true,
 "store_unverified_halt_min": 90,
 "store_no_progress_launches": 4,
 "store_stall_min": 240,
 "store_no_progress_min": 420,
 "store_inputs": [
  {
   "branch": "main",
   "prefix": "seed/vocab",
   "to": "chat/upload"
  },
  {
   "branch": "main",
   "prefix": "corpus/N",
   "to": "chat/data",
   "files": [
    "N.main.ids",
    "N.tail.ids"
   ]
  },
  {
   "branch": "main",
   "prefix": "corpus/panels",
   "to": "chat/data"
  },
  {
   "branch": "main",
   "prefix": "corpus/panel_scenario",
   "to": "chat/data",
   "files": [
    "panel_scenario.ids"
   ]
  }
 ],
 "max_parallel": 1,
 "max_parallel_light": 2,
 "jobs": [
  {
   "name": "pins",
   "light": true,
   "halt_on_failure": true,
   "cmd": [
    "python3",
    "tools/colab_chat/base2_pins.py",
    "/content/chat/data",
    "arm-N",
    "--upload",
    "/content/chat/upload",
    "--out",
    "{out}/pins.json"
   ],
   "outputs": [
    "pins.json"
   ]
  },
  {
   "name": "watch",
   "light": true,
   "after": "pins",
   "cmd": [
    "timeout",
    "-k",
    "30",
    "14700",
    "python3",
    "tools/colab_chat/w169_watch.py",
    "--chat",
    "/content/chat",
    "--job",
    "pt_w169_reh",
    "--out",
    "{out}",
    "--interval",
    "30",
    "--limit-s",
    "14400"
   ],
   "outputs": [
    "watch_summary.json",
    "watch.jsonl"
   ]
  },
  {
   "name": "pt_w169_reh",
   "model_name": "base2_W169_rehearsal",
   "store_branch": "ckpt-W169reh",
   "after": [
    "pins"
   ],
   "snapshot_steps": [
    750
   ],
   "pod_loss_drill_step": 250,
   "halt_on_failure": true,
   "env": {
    "MICROTORCH_CHECKPOINT_TXN": "1"
   },
   "spec": {
    "name": "base2_W169_rehearsal",
    "arch": {
     "preset": "llama-tiny",
     "rope_heads": "all",
     "custom": {
      "d": 1024,
      "layers": 12,
      "heads": 16,
      "d_ff": 2752
     },
     "state_tokens": {
      "k": 4,
      "mask": "causal"
     }
    },
    "data": {
     "corpus": "/content/chat/data/N.main.ids",
     "vocab": "/content/chat/upload/vocab_llama3_bpe.gguf",
     "vocab_cap": 16384,
     "T": 1024,
     "max_tokens": 0,
     "anneal": {
      "corpus": "/content/chat/data/N.tail.ids",
      "from_fraction": 0.85
     }
    },
    "train": {
     "steps": 1000,
     "lr": 0.0003,
     "batch": 8,
     "accum": 2,
     "clip": 1.0,
     "eval_every": 250,
     "eval_windows": 32,
     "checkpoint_every": 250,
     "gradmap_every": 0,
     "seed": 1,
     "optimizer": "adamw",
     "precision": "bf16",
     "attention_kernel": "flash",
     "lr_schedule": {
      "warmup_steps": 100,
      "decay": "cosine",
      "min_lr_frac": 0.1
     }
    },
    "export": {
     "formats": [
      "safetensors",
      "gguf"
     ]
    },
    "out_dir": "/content/chat/pt_w169_reh"
   }
  },
  {
   "name": "rung_W169reh_s750",
   "after": "pins",
   "light": true,
   "env": {
    "MICROTORCH_POOL_MB": 1024
   },
   "cmd": [
    "python3",
    "tools/colab_chat/tiny_chat_run.py",
    "rung",
    "--out",
    "{out}",
    "--spec",
    "tools/colab_chat/base2_rung_W169.json",
    "--export-gguf",
    "--weights",
    "/content/chat/pt_w169_reh/rung_750/model.safetensors",
    "--pt-dir",
    "/content/chat/pt_w169_reh",
    "--step",
    "750",
    "--job",
    "pt_w169_reh",
    "--cell",
    "BASE2_W169reh",
    "--seed",
    "1",
    "--share",
    "28",
    "--panel",
    "fineweb=/content/chat/data/panel_fineweb.ids",
    "--panel",
    "dialogue=/content/chat/data/panel_dialogue.ids",
    "--panel",
    "scenario=/content/chat/data/panel_scenario.ids",
    "--carry5-items",
    "corpus/eval/carry5_v1.jsonl",
    "--score-batch-tokens",
    "4096",
    "--score-chunk",
    "4096"
   ],
   "outputs": [
    "rung.json"
   ],
   "rung_of": {
    "job": "pt_w169_reh",
    "step": 750
   },
   "exclusive": true,
   "timeout_s": 10800
  },
  {
   "name": "rung_W169reh_s1000",
   "after": [
    "pt_w169_reh"
   ],
   "light": true,
   "env": {
    "MICROTORCH_POOL_MB": 1024
   },
   "cmd": [
    "timeout",
    "-k",
    "60",
    "10800",
    "python3",
    "tools/colab_chat/tiny_chat_run.py",
    "rung",
    "--out",
    "{out}",
    "--spec",
    "tools/colab_chat/base2_rung_W169.json",
    "--export-gguf",
    "--weights",
    "/content/chat/pt_w169_reh/model.safetensors",
    "--pt-dir",
    "/content/chat/pt_w169_reh",
    "--step",
    "1000",
    "--job",
    "pt_w169_reh",
    "--cell",
    "BASE2_W169reh",
    "--seed",
    "1",
    "--share",
    "28",
    "--panel",
    "fineweb=/content/chat/data/panel_fineweb.ids",
    "--panel",
    "dialogue=/content/chat/data/panel_dialogue.ids",
    "--panel",
    "scenario=/content/chat/data/panel_scenario.ids",
    "--carry5-items",
    "corpus/eval/carry5_v1.jsonl",
    "--score-batch-tokens",
    "4096",
    "--score-chunk",
    "4096"
   ],
   "outputs": [
    "rung.json"
   ]
  }
 ]
}
