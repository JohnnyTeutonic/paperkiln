{
 "_comment": "Token ladder, chat campaign on base ST (lane base2/token_ladder/REGISTRATION.md), rendered by tools/colab_chat/ladder_chat_jobs.py; edit that file, not this one.",
 "max_parallel": 1,
 "max_parallel_light": 2,
 "home_markers": true,
 "jobs": [
  {
   "name": "repro_A",
   "spec": {
    "data": {
     "vocab": "/content/chat/upload/vocab.gguf",
     "vocab_cap": 16384,
     "T": 1024,
     "sft_examples": "/content/chat/upload/sft_human.jsonl"
    },
    "train": {
     "objective": "sft",
     "steps": 50,
     "lr": 0.0003,
     "batch": 16,
     "accum": 1,
     "clip": 1.0,
     "eval_every": 500,
     "eval_batch": 8,
     "checkpoint_every": 25,
     "gradmap_every": 0,
     "seed": 1,
     "optimizer": "adamw",
     "lr_schedule": {
      "warmup_steps": 100,
      "decay": "cosine",
      "min_lr_frac": 0.1
     },
     "init_from": "/content/chat/upload/base_A.safetensors"
    },
    "export": {
     "formats": [
      "safetensors"
     ]
    },
    "arch": {
     "preset": "llama-tiny",
     "rope_heads": "all",
     "custom": {
      "d": 768,
      "layers": 8,
      "heads": 12,
      "d_ff": 2240
     },
     "state_tokens": {
      "k": 4,
      "mask": "causal"
     }
    }
   },
   "relay_every_steps": 100000
  },
  {
   "name": "gate",
   "light": true,
   "after": [
    "repro_A"
   ],
   "after_terminal": true,
   "cmd": [
    "python3",
    "tools/colab_chat/b2cue_early.py",
    "--repro",
    "--job",
    "repro_A",
    "--ref",
    "/content/chat/upload/sft_b1_r1_events.jsonl",
    "--steps",
    "50",
    "--out",
    "{out}",
    "--chat",
    "/content/chat"
   ],
   "outputs": [
    "repro.json"
   ]
  },
  {
   "name": "sft_tlST",
   "spec": {
