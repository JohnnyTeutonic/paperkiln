{
 "_comment": "LOCAL_LLM_WORK R3, experiments/lowbit_2026-10-28: BitNet b1.58 ternary QAT at E1's 20m_L16 shape and recipe (the shape spec shape_20m_L16_bit.json: arch.custom.bitlinear, lr 0.001, 10000 x 16384 tokens), on E1's data job (the gate refuses unless mix_s35.ids and both panels hash as E1's ledger and test_bitlinear passes its CUDA leg). Post as E1's (SFT 1500 steps, panels, Carry-5) with --gen mtstudio: no engine serves BitLinear. bench_bit: the seven benchmarks through mtstudio score. panels_home brings the panel files home for the PTQ campaign. Upload vocab_llama3_bpe.gguf. Seed 1.",
 "max_parallel": 1,
 "max_parallel_light": 1,
 "jobs": [
  {
   "name": "data",
   "cmd": [
    "python3",
    "tools/colab_chat/tiny_chat_data.py",
    "--out",
    "{out}",
    "--vocab",
    "/content/chat/upload/vocab_llama3_bpe.gguf",
    "--fineweb",
    "corpus/data/fineweb_edu_shard0_v1",
    "--shares",
    "35",
    "--mix-bytes",
    "800000000",
    "--max-epochs",
    "4",
    "--T",
    "512",
    "--seed",
    "1",
    "--human-fetch",
    "python3 corpus/fetchers/human_dialogue.py oasst,convai2,wow,bst,taskmaster,multiwoz,self_dialogue,topical_chat,dolly,quac,empathetic,dailydialog,no_robots --allow-sa --allow-nc --out-dir {human}",
    "--sources",
    "oasst,convai2,wow,bst,taskmaster,multiwoz,self_dialogue,topical_chat,dolly,quac,empathetic,dailydialog,no_robots",
    "--require-pinned"
   ],
   "outputs": [
    "data.ledger.json"
   ]
  },
  {
   "name": "gate",
   "after": "data",
   "cmd": [
    "python3",
    "experiments/lowbit_2026-10-28/lowbit_vm.py",
    "gate",
    "{out}"
   ],
   "outputs": [
    "gate.json",
    "test_bitlinear.txt"
   ]
  },
  {
   "name": "panels_home",
   "after": "data",
   "light": true,
   "cmd": [
    "bash",
    "-c",
    "cp /content/chat/data/panel_fineweb.ids /content/chat/data/panel_dialogue.ids /content/chat/data/data.ledger.json {out}/"
   ],
   "outputs": [
    "panel_fineweb.ids",
    "panel_dialogue.ids",
    "data.ledger.json"
   ]
  },
  {
   "name": "pt_bit_r1",
   "model_name": "tc_e1_bit_r1",
   "after": [
    "data",
    "gate"
   ],
   "relay_every_steps": 250,
   "spec": {
    "arch": {
     "preset": "llama-tiny",
     "rope_heads": "all",
     "custom": {
      "d": 320,
      "layers": 16,
      "heads": 5,
      "d_ff": 864,
      "bitlinear": {
       "weights": "ternary",
       "act_bits": 8,
       "in_norm": true
      }
     }
    },
    "data": {
     "corpus": "/content/chat/data/mix_s35.ids",
     "vocab": "/content/chat/upload/vocab_llama3_bpe.gguf",
     "vocab_cap": 16384,
     "T": 512,
     "max_tokens": 0
    },
    "train": {
     "steps": 10000,
     "lr": 0.001,
     "batch": 16,
     "accum": 2,
     "clip": 1.0,
     "eval_every": 500,
     "eval_windows": 32,
     "checkpoint_every": 250,
     "gradmap_every": 0,
     "seed": 1,
     "optimizer": "adamw",
     "lr_schedule": {
      "warmup_steps": 500,
      "decay": "cosine",
      "min_lr_frac": 0.1
     }
    },
    "export": {
     "formats": [
      "safetensors"
     ]
    },
    "name": "tc_20m_L16_bit"
   }
  },
  {
   "name": "post_bit_r1",
   "after": "pt_bit_r1",
   "init_job": "pt_bit_r1",
   "cmd": [
    "python3",
    "tools/colab_chat/tiny_chat_run.py",
    "post",
    "--out",
    "{out}",
    "--spec",
    "experiments/lowbit_2026-10-28/specs/shape_20m_L16_bit.json",
    "--pt-weights",
    "/content/chat/pt_bit_r1/tc_e1_bit_r1.safetensors",
    "--pt-dir",
    "/content/chat/pt_bit_r1",
    "--sft-template",
    "experiments/tiny_chat_2026-10/specs/sft.json",
    "--seed",
    "1",
    "--cell",
    "BIT",
    "--share",
    "35",
    "--panel",
    "fineweb=/content/chat/data/panel_fineweb.ids",
    "--panel",
    "dialogue=/content/chat/data/panel_dialogue.ids",
    "--carry5-items",
    "corpus/eval/carry5_v1.jsonl",
    "--gen",
    "mtstudio"
   ],
   "outputs": [
    "summary.json",
    "carry5/m/items.jsonl",
    "carry5/m/gen.jsonl",
    "sft_spec.json",
    "sft/tc_sft_BIT_r1.safetensors"
   ]
  },
  {
   "name": "bench_bit_r1",
   "after": "post_bit_r1",
   "light": true,
   "cmd": [
    "python3",
    "experiments/lowbit_2026-10-28/lowbit_vm.py",
    "bench_mt",
    "{out}",
    "/content/chat/post_bit_r1/sft_spec.json"
   ],
   "outputs": [
    "bench_summary.json",
    "bench.log"
   ]
  }
 ]
}