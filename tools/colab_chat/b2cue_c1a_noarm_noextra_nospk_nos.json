{
 "_comment": "A32 (b2cue) campaign c1a, rendered by tools/colab_chat/b2cue_jobs.py; edit that file, not this one.",
 "max_parallel": 1,
 "max_parallel_light": 2,
 "home_markers": true,
 "jobs": [
  {
   "name": "gate",
   "cmd": [
    "python3",
    "tools/colab_chat/b2cue_gate.py",
    "--out",
    "{out}",
    "--bin",
    "/content/pk/build_cuda/mtstudio",
    "--device-test",
    "/content/pk/build_cuda/test_twin_device",
    "--spec",
    "/content/chat/upload/b2cue_gate_D1.json"
   ],
   "outputs": [
    "gate.json"
   ]
  },
  {
   "name": "score_start_N250",
   "light": true,
   "after": "gate",
   "cmd": [
    "bash",
    "-c",
    "mkdir -p {out}/m && ln -sf /content/chat/upload/start_N250.safetensors {out}/m/score_start_N250.safetensors && cp /content/chat/upload/start_N250_spec.json {out}/m/spec.json && ok=0; for i in 1 2 3; do echo $i > {out}/attempts.txt; timeout 6600 /content/pk/build_cuda/mtstudio score {out}/m --in /content/chat/upload/b2cue_confirmation_req.jsonl --out {out}/scores.jsonl --batch-tokens 8192 && ok=1 && break; done; [ $ok = 1 ] && python3 tools/colab_chat/a31_bind.py --scores {out}/scores.jsonl --weights /content/chat/upload/start_N250.safetensors --requests /content/chat/upload/b2cue_confirmation_req.jsonl --bin /content/pk/build_cuda/mtstudio --spec {out}/m/spec.json --out {out}/score.json"
   ],
   "outputs": [
    "scores.jsonl",
    "score.json",
    "attempts.txt"
   ]
  },
  {
   "name": "P_N250_1",
   "spec": {
    "arch": {
     "preset": "llama-tiny",
     "rope_heads": "all",
     "custom": {
      "d": 512,
      "layers": 18,
      "heads": 8,
      "d_ff": 1536
     },
     "state_tokens": {
      "k": 4,
      "mask": "causal"
     }
    },
    "data": {
     "vocab": "/content/chat/upload/vocab.gguf",
     "vocab_cap": 16384,
     "T": 1024,
     "sft_examples": "/content/chat/upload/S74.jsonl"
    },
    "train": {
     "objective": "sft",
     "steps": 1024,
     "lr": 0.0001,
     "batch": 16,
     "accum": 1,
     "clip": 1.0,
     "eval_every": 32,
     "eval_batch": 8,
     "checkpoint_every": 128,
     "gradmap_every": 0,
     "seed": 1,
     "optimizer": "adamw",
     "init_from": "/content/chat/upload/start_N250.safetensors",
     "lr_schedule": {
      "warmup_steps": 64,
      "decay": "cosine",
      "min_lr_frac": 0.1
     },
     "eval_examples": 256
    },
    "export": {
     "formats": [
      "safetensors",
      "gguf"
     ]
    }
   },
   "after": [
    "gate"
   ],
   "relay_every_steps": 100000,
   "snapshot_steps": [
    128,
    256,
    512
   ]
  },
  {
   "name": "early_P_N250_1_128",
   "light": true,
   "rung_of": {
    "job": "P_N250_1",
    "step": 128
   },
   "cmd": [
    "python3",
    "tools/colab_chat/b2cue_early.py",
    "--job",
    "P_N250_1",
    "--step",
    "128",
    "--ref",
    "P_N250_1",
    "--out",
    "{out}",
    "--chat",
    "/content/chat",
    "--bin",
    "/content/pk/build_cuda/mtstudio",
    "--no-score"
   ],
   "outputs": [
    "early.json"
   ]
  },
