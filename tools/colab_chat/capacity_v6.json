    "arch": {
     "preset": "llama-tiny",
     "custom": {
      "d": 768,
      "layers": 12,
      "heads": 12,
      "d_ff": 2048
     }
    },
    "data": {
     "vocab": "/content/pk/corpus/data/vocab_fineweb_tinychat_bpe8k_v1/fineweb_tinychat_bpe8k.gguf",
