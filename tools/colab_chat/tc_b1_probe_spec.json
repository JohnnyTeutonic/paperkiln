{
 "name": "probe",
 "arch": {
  "preset": "llama-tiny",
  "rope_heads": "all",
  "custom": {
   "d": 768,
   "layers": 8,
   "heads": 12,
   "d_ff": 2240
  },
  "state_tokens": {
   "k": 4,
   "mask": "causal"
  }
 },
 "data": {
  "corpus": "/content/chat/data/mix_b1.main.ids",
  "vocab": "/content/chat/upload/vocab_llama3_bpe.gguf",
  "vocab_cap": 16384,
  "T": 1024,
  "max_tokens": 0,
  "anneal": {
   "corpus": "/content/chat/data/mix_b1.tail.ids",
   "from_fraction": 0.85
  }
 },
 "train": {
  "steps": 150,
  "lr": 0.0005,
  "batch": 16,
  "accum": 1,
  "clip": 1.0,
  "eval_every": 1000,
  "eval_windows": 32,
  "checkpoint_every": 50,
  "gradmap_every": 0,
  "seed": 1,
  "optimizer": "adamw",
  "lr_schedule": {
   "warmup_steps": 20,
   "decay": "cosine",
   "min_lr_frac": 0.1
  }
 },
 "export": {
  "formats": [
   "safetensors"
  ]
 }
}
