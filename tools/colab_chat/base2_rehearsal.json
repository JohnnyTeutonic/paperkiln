{
 "_comment": "Base 2's rehearsal of the store path, part a (BASE2_PLAN.md section 5): a forced stop before the tail switch. The control starts when the interrupted run and its rung have both ended.",
 "_base2": {
  "rehearsal": "a",
  "steps": 2000,
  "last_main_step": 1000,
  "first_tail_step": 1001,
  "checkpoint_every": 200,
  "pod_loss_drill_step": 400,
  "mark": 200,
  "rung_holds_training": false,
  "watch": "ART/watch/watch.jsonl: the watch job's own file on the VM, home with its outputs (pt_reh)",
  "runs": "alone on the store: part a to its end, then part b",
  "after": null,
  "shared_with_the_other_part": [
   "main:corpus/rehearsal"
  ],
  "store_release_grace_s": 600
 },
 "store_push_cap_gb": 28,
 "store_release_every_min": 20,
 "store_inputs": [
  {
   "branch": "main",
   "prefix": "seed/vocab",
   "to": "chat/upload"
  }
 ],
 "max_parallel": 1,
 "max_parallel_light": 2,
 "jobs": [
  {
   "name": "data",
   "light": true,
   "halt_on_failure": true,
   "cmd": [
    "bash",
    "tools/colab_chat/base2_data.sh",
    "{out}",
    "/content/chat/upload/vocab_llama3_bpe.gguf",
    "rehearsal"
   ],
   "outputs": [
    "rehearsal.json",
    "base2_pins_observed.json"
   ]
  },
  {
   "name": "watch",
   "light": true,
   "after": "data",
   "cmd": [
    "timeout",
    "-k",
    "30",
    "7500",
    "python3",
    "tools/colab_chat/base2_corpus.py",
    "drill-watch",
    "--chat",
    "/content/chat",
    "--job",
    "pt_reh",
    "--out",
    "{out}",
    "--interval",
    "30",
    "--limit-s",
    "7200"
   ],
   "outputs": [
    "watch_summary.json",
    "watch.jsonl"
   ]
  },
  {
   "name": "pt_reh",
   "model_name": "base2_rehearsal_a",
   "store_branch": "ckpt-R",
   "after": [
    "data"
   ],
   "snapshot_steps": [
    200
   ],
   "pod_loss_drill_step": 400,
   "halt_on_failure": true,
   "env": {
    "MICROTORCH_CHECKPOINT_TXN": "1"
   },
   "spec": {
    "name": "base2_rehearsal_a",
    "arch": {
     "preset": "llama-tiny",
     "rope_heads": "all",
     "custom": {
      "d": 512,
      "layers": 18,
      "heads": 8,
      "d_ff": 1536
     },
     "state_tokens": {
      "k": 4,
      "mask": "causal"
     }
    },
    "data": {
     "corpus": "/content/chat/data/rehearsal.main.ids",
     "vocab": "/content/chat/upload/vocab_llama3_bpe.gguf",
     "vocab_cap": 16384,
     "T": 1024,
     "max_tokens": 0,
     "anneal": {
      "corpus": "/content/chat/data/rehearsal.tail.ids",
      "from_fraction": 0.5
     }
    },
    "train": {
     "steps": 2000,
     "lr": 0.0005,
     "batch": 8,
     "accum": 2,
     "clip": 1.0,
     "eval_every": 200,
     "eval_windows": 32,
     "checkpoint_every": 200,
     "gradmap_every": 0,
     "seed": 1,
     "optimizer": "adamw",
     "precision": "bf16",
     "attention_kernel": "flash",
     "lr_schedule": {
      "warmup_steps": 100,
      "decay": "cosine",
      "min_lr_frac": 0.1
     }
    },
    "export": {
     "formats": [
      "safetensors"
     ]
    },
    "out_dir": "/content/chat/pt_reh"
   }
  },
  {
   "name": "rung_R_s200",
   "after": "data",
   "light": true,
   "env": {
    "MICROTORCH_POOL_MB": 1024
   },
   "cmd": [
    "timeout",
    "-k",
    "60",
    "3600",
    "python3",
    "tools/colab_chat/tiny_chat_run.py",
    "rung",
    "--out",
    "{out}",
    "--spec",
    "tools/colab_chat/base2_rung_D1.json",
    "--export-gguf",
    "--weights",
    "/content/chat/pt_reh/rung_200/model.safetensors",
    "--pt-dir",
    "/content/chat/pt_reh",
    "--step",
    "200",
    "--job",
    "pt_reh",
    "--cell",
    "BASE2_R",
    "--seed",
    "1",
    "--share",
    "28",
    "--panel",
    "main=/content/chat/data/rehearsal.main.ids",
    "--panel",
    "tail=/content/chat/data/rehearsal.tail.ids",
    "--carry5-items",
    "corpus/eval/carry5_v1.jsonl",
    "--score-batch-tokens",
    "4096",
    "--score-chunk",
    "4096"
   ],
   "outputs": [
    "rung.json"
   ],
   "rung_of": {
    "job": "pt_reh",
    "step": 200
   }
  },
  {
   "name": "pt_reh_control",
   "model_name": "base2_rehearsal_a_control",
   "store_branch": "ckpt-Rc",
   "after": [
    "pt_reh",
    "rung_R_s200"
   ],
   "after_terminal": true,
   "halt_on_failure": true,
   "env": {
    "MICROTORCH_CHECKPOINT_TXN": "1"
   },
   "spec": {
    "name": "base2_rehearsal_a_control",
    "arch": {
     "preset": "llama-tiny",
     "rope_heads": "all",
     "custom": {
      "d": 512,
      "layers": 18,
      "heads": 8,
      "d_ff": 1536
     },
     "state_tokens": {
      "k": 4,
      "mask": "causal"
     }
    },
    "data": {
     "corpus": "/content/chat/data/rehearsal.main.ids",
     "vocab": "/content/chat/upload/vocab_llama3_bpe.gguf",
     "vocab_cap": 16384,
     "T": 1024,
     "max_tokens": 0,
     "anneal": {
      "corpus": "/content/chat/data/rehearsal.tail.ids",
      "from_fraction": 0.5
     }
    },
    "train": {
     "steps": 2000,
     "lr": 0.0005,
     "batch": 8,
     "accum": 2,
     "clip": 1.0,
     "eval_every": 200,
     "eval_windows": 32,
     "checkpoint_every": 200,
     "gradmap_every": 0,
     "seed": 1,
     "optimizer": "adamw",
     "precision": "bf16",
     "attention_kernel": "flash",
     "lr_schedule": {
      "warmup_steps": 100,
      "decay": "cosine",
      "min_lr_frac": 0.1
     }
    },
    "export": {
     "formats": [
      "safetensors"
     ]
    },
    "out_dir": "/content/chat/pt_reh_control"
   }
  }
 ]
}
