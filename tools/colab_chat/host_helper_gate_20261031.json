{
  "max_parallel": 1,
  "jobs": [
    {
      "name": "host_helper_gate",
      "cmd": [
        "timeout",
        "--signal=TERM",
        "--kill-after=30",
        "1530",
        "python3",
        "/content/chat/upload/host_helper_gate.py",
        "--upload",
        "/content/chat/upload",
        "--manifest-sha256",
        "3ab069e1f144aae1461a1a0c6bb3c1bfd584b25d8f1e6fe41d7caba1a7458ed7",
        "--out",
        "{out}"
      ],
      "outputs": [
        "gate_summary.json",
        "out.zip"
      ]
    }
  ]
}
