{
  "max_parallel": 1,
  "jobs": [
    {
      "name": "attention_precision_gate",
      "cmd": [
        "timeout",
        "--signal=TERM",
        "--kill-after=30",
        "1530",
        "python3",
        "/content/chat/upload/attention_precision_gate.py",
        "--upload",
        "/content/chat/upload",
        "--manifest-sha256",
        "f03285674bc94ee0e086a31094ec0c8b0ff5db7a968527ebf5e57725c193c5ef",
        "--out",
        "{out}"
      ],
      "outputs": [
        "gate_summary.json",
        "out.zip",
        "strict.log",
        "hardware.log",
        "nvcc.log",
        "configure.log",
        "build.log",
        "numpy_install.log",
        "independent_replay.log"
      ]
    }
  ]
}
