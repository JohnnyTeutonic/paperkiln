{
  "max_parallel": 1,
  "jobs": [
    {
      "name": "mamba1_cli_gate",
      "cmd": [
        "timeout",
        "--signal=TERM",
        "--kill-after=30",
        "1530",
        "python3",
        "/content/chat/upload/mamba1_cli_gate.py",
        "--upload",
        "/content/chat/upload",
        "--manifest-sha256",
        "cc95af6e789f28aecae56bed3fc8c0749984de918cc7de6cbcc97f5eca15b311",
        "--out",
        "{out}"
      ],
      "outputs": [
        "gate_summary.json",
        "out.zip"
      ]
    }
  ]
}
