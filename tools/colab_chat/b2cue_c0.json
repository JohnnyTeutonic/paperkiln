{
 "_comment": "A32 (b2cue) campaign c0, rendered by tools/colab_chat/b2cue_jobs.py; edit that file, not this one.",
 "max_parallel": 1,
 "max_parallel_light": 2,
 "home_markers": true,
 "jobs": [
  {
   "name": "gate",
   "cmd": [
    "python3",
    "tools/colab_chat/b2cue_gate.py",
    "--out",
    "{out}",
    "--bin",
    "/content/pk/build_cuda/mtstudio",
    "--device-test",
    "/content/pk/build_cuda/test_twin_device",
    "--spec",
    "/content/chat/upload/b2cue_gate_D1.json"
   ],
   "outputs": [
    "gate.json"
   ]
  },
  {
   "name": "sft_N250",
   "spec": {
    "data": {
     "vocab": "/content/chat/upload/vocab.gguf",
     "vocab_cap": 16384,
     "T": 1024,
     "sft_examples": "/content/chat/upload/sft_human.jsonl"
    },
    "train": {
     "objective": "sft",
     "steps": 1500,
     "lr": 0.0003,
     "batch": 16,
     "accum": 1,
     "clip": 1.0,
     "eval_every": 500,
     "eval_batch": 8,
     "checkpoint_every": 25,
     "gradmap_every": 0,
     "seed": 1,
     "optimizer": "adamw",
     "lr_schedule": {
      "warmup_steps": 100,
      "decay": "cosine",
      "min_lr_frac": 0.1
     },
     "eval_at": [
      188,
      375,
      750
     ],
     "init_from": "/content/chat/upload/base_N250.safetensors"
    },
    "export": {
     "formats": [
      "safetensors",
      "gguf"
     ]
    },
    "arch": {
     "preset": "llama-tiny",
     "rope_heads": "all",
     "custom": {
      "d": 512,
      "layers": 18,
      "heads": 8,
      "d_ff": 1536
     },
     "state_tokens": {
      "k": 4,
      "mask": "causal"
     }
    }
   },
   "after": "gate",
   "relay_every_steps": 100000,
   "env": {
    "MICROTORCH_CHECKPOINT_TXN": "1"
   }
  },
  {
